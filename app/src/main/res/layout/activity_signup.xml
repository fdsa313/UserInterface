<?xml version="1.0" encoding="utf-8"?>
<!-- Android 회원가입 화면 레이아웃 -->
<!-- res/layout/activity_signup.xml -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/gradient_background"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="24dp">

        <!-- 상단 아이콘 영역 -->
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="32dp">

            <!-- 아이콘 컨테이너 -->
            <FrameLayout
                android:id="@+id/icon_container"
                android:layout_width="80dp"
                android:layout_height="80dp"
                android:layout_centerHorizontal="true"
                android:background="@drawable/icon_container_bg">

                <ImageView
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_school"
                    android:contentDescription="@string/school_icon" />
            </FrameLayout>

            <!-- 헤딩 텍스트 -->
            <TextView
                android:id="@+id/heading_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_below="@id/icon_container"
                android:layout_centerHorizontal="true"
                android:layout_marginTop="16dp"
                android:text="숭실대 할인 혜택"
                android:textColor="#101828"
                android:textSize="16sp"
                android:fontFamily="sans-serif" />

            <!-- 설명 텍스트 -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_below="@id/heading_text"
                android:layout_centerHorizontal="true"
                android:layout_marginTop="8dp"
                android:text="숭실인을 위한 특별한 제휴 혜택"
                android:textColor="#4a5565"
                android:textSize="16sp"
                android:fontFamily="sans-serif" />
        </RelativeLayout>

        <!-- 탭 레이아웃 (로그인/회원가입) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="36dp"
            android:layout_marginBottom="32dp"
            android:background="@drawable/tab_background"
            android:orientation="horizontal"
            android:padding="3dp">

            <TextView
                android:id="@+id/tab_login"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="center"
                android:text="로그인"
                android:textColor="#000000"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/tab_signup"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@drawable/tab_selected"
                android:gravity="center"
                android:text="회원가입"
                android:textColor="#000000"
                android:textSize="14sp" />
        </LinearLayout>

        <!-- 회원가입 카드 -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="32dp"
            app:cardCornerRadius="14dp"
            app:cardElevation="1dp"
            app:cardBackgroundColor="#FFFFFF">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="24dp">

                <!-- 아이디 입력 -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="아이디"
                    android:textColor="#000000"
                    android:textSize="14sp"
                    android:layout_marginBottom="8dp" />

                <EditText
                    android:id="@+id/input_username"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:background="@drawable/input_background"
                    android:hint="아이디를 입력하세요"
                    android:textColorHint="#717182"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"
                    android:textSize="16sp"
                    android:layout_marginBottom="16dp"
                    android:inputType="text" />

                <!-- 이메일 입력 -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="이메일"
                    android:textColor="#000000"
                    android:textSize="14sp"
                    android:layout_marginBottom="8dp" />

                <EditText
                    android:id="@+id/input_email"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:background="@drawable/input_background"
                    android:hint="이메일을 입력하세요"
                    android:textColorHint="#717182"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"
                    android:textSize="16sp"
                    android:layout_marginBottom="16dp"
                    android:inputType="textEmailAddress" />

                <!-- 비밀번호 입력 -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="비밀번호"
                    android:textColor="#000000"
                    android:textSize="14sp"
                    android:layout_marginBottom="8dp" />

                <EditText
                    android:id="@+id/input_password"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:background="@drawable/input_background"
                    android:hint="비밀번호를 입력하세요"
                    android:textColorHint="#717182"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"
                    android:textSize="16sp"
                    android:layout_marginBottom="16dp"
                    android:inputType="textPassword" />

                <!-- 비밀번호 확인 -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="비밀번호 확인"
                    android:textColor="#000000"
                    android:textSize="14sp"
                    android:layout_marginBottom="8dp" />

                <EditText
                    android:id="@+id/input_password_confirm"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:background="@drawable/input_background"
                    android:hint="비밀번호를 다시 입력하세요"
                    android:textColorHint="#717182"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"
                    android:textSize="16sp"
                    android:layout_marginBottom="24dp"
                    android:inputType="textPassword" />

                <!-- 회원가입 버튼 -->
                <Button
                    android:id="@+id/btn_signup"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:background="@drawable/button_primary_disabled"
                    android:backgroundTint="@null"
                    app:backgroundTint="@null"
                    app:rippleColor="@android:color/transparent"
                    android:text="회원가입"
                    android:textColor="#FFFFFF"
                    android:textSize="14sp"
                    android:layout_marginBottom="24dp"
                    android:enabled="false"
                    android:alpha="0.5" />

                <!-- 구분선 영역 -->
                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="16dp">

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:layout_centerVertical="true"
                        android:background="#1A000000" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_centerInParent="true"
                        android:background="#FFFFFF"
                        android:paddingStart="8dp"
                        android:paddingEnd="8dp"
                        android:text="또는"
                        android:textColor="#6a7282"
                        android:textSize="16sp" />
                </RelativeLayout>

                <!-- 카카오톡 회원가입 버튼 -->
                <Button
                    android:id="@+id/btn_kakao_signup"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:layout_gravity="center_horizontal"
                    android:background="@drawable/button_kakao"
                    android:backgroundTint="@null"
                    app:backgroundTint="@null"
                    app:rippleColor="@android:color/transparent"
                    android:drawableStart="@drawable/ic_kakao"
                    android:drawableTint="@null"
                    app:drawableTint="@null"
                    android:drawablePadding="8dp"
                    android:gravity="center"
                    android:paddingStart="32dp"
                    android:paddingEnd="32dp"
                    android:minWidth="0dp"
                    android:text="카카오톡으로 회원가입"
                    android:textColor="#101828"
                    android:textSize="14sp" />
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- 하단 약관 텍스트 -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="회원가입 시 서비스 이용약관 및"
                android:textColor="#6a7282"
                android:textSize="16sp"
                android:gravity="center" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="개인정보 처리방침에 동의하게 됩니다"
                android:textColor="#6a7282"
                android:textSize="16sp"
                android:gravity="center" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>

