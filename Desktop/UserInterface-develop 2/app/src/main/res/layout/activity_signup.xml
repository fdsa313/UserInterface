<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="#E8EAF6">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="32dp">

        <!-- Logo Icon -->
        <androidx.cardview.widget.CardView
            android:id="@+id/logoCard"
            android:layout_width="120dp"
            android:layout_height="120dp"
            app:cardCornerRadius="28dp"
            app:cardElevation="8dp"
            app:cardBackgroundColor="@color/primary_blue"
            android:layout_marginTop="32dp"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <ImageView
                android:layout_width="64dp"
                android:layout_height="64dp"
                android:src="@drawable/ic_school"
                app:tint="@color/text_white"
                android:layout_gravity="center"
                android:contentDescription="@string/app_name" />

        </androidx.cardview.widget.CardView>

        <!-- Title -->
        <TextView
            android:id="@+id/tvTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/app_title"
            android:textSize="24sp"
            android:textStyle="bold"
            android:textColor="@color/text_primary"
            android:layout_marginTop="24dp"
            app:layout_constraintTop_toBottomOf="@id/logoCard"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <!-- Subtitle -->
        <TextView
            android:id="@+id/tvSubtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/app_subtitle"
            android:textSize="14sp"
            android:textColor="@color/text_secondary"
            android:layout_marginTop="8dp"
            app:layout_constraintTop_toBottomOf="@id/tvTitle"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <!-- Tabs -->
        <LinearLayout
            android:id="@+id/tabContainer"
            android:layout_width="0dp"
            android:layout_height="56dp"
            android:orientation="horizontal"
            android:layout_marginTop="32dp"
            android:padding="4dp"
            android:background="@drawable/tab_segment_container"
            app:layout_constraintTop_toBottomOf="@id/tvSubtitle"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <TextView
                android:id="@+id/tabLogin"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="match_parent"
                android:layout_marginEnd="4dp"
                android:text="@string/tab_login"
                android:textSize="16sp"
                android:textStyle="normal"
                android:textColor="@color/text_primary"
                android:gravity="center"
                android:background="@drawable/tab_segment_unselected"
                android:clickable="true"
                android:focusable="true" />

            <TextView
                android:id="@+id/tabSignup"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="match_parent"
                android:layout_marginStart="4dp"
                android:text="@string/tab_signup"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="@color/text_primary"
                android:gravity="center"
                android:background="@drawable/tab_segment_selected"
                android:clickable="true"
                android:focusable="true" />

        </LinearLayout>

        <!-- Signup Form Card -->
        <androidx.cardview.widget.CardView
            android:id="@+id/signupCard"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            app:cardCornerRadius="24dp"
            app:cardElevation="4dp"
            app:cardBackgroundColor="@color/background_white"
            android:layout_marginTop="33dp"
            app:layout_constraintTop_toBottomOf="@id/tabContainer"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="32dp">

                <!-- ID Label -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/label_id"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:textColor="@color/text_primary"
                    android:layout_marginBottom="8dp" />

                <!-- ID Input -->
                <EditText
                    android:id="@+id/etSignupId"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:hint="@string/hint_id"
                    android:textSize="14sp"
                    android:textColorHint="@color/text_secondary"
                    android:background="@drawable/input_background"
                    android:paddingHorizontal="20dp"
                    android:inputType="text"
                    android:autofillHints="username"
                    android:layout_marginBottom="20dp" />

                <!-- Email Label -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/label_email"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:textColor="@color/text_primary"
                    android:layout_marginBottom="8dp" />

                <!-- Email Input -->
                <EditText
                    android:id="@+id/etSignupEmail"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:hint="@string/hint_email"
                    android:textSize="14sp"
                    android:textColorHint="@color/text_secondary"
                    android:background="@drawable/input_background"
                    android:paddingHorizontal="20dp"
                    android:inputType="textEmailAddress"
                    android:autofillHints="emailAddress"
                    android:layout_marginBottom="20dp" />

                <!-- Password Label -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/label_password"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:textColor="@color/text_primary"
                    android:layout_marginBottom="8dp" />

                <!-- Password Input -->
                <EditText
                    android:id="@+id/etSignupPassword"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:hint="@string/hint_password"
                    android:textSize="14sp"
                    android:textColorHint="@color/text_secondary"
                    android:background="@drawable/input_background"
                    android:paddingHorizontal="20dp"
                    android:inputType="textPassword"
                    android:autofillHints="password"
                    android:layout_marginBottom="20dp" />

                <!-- Password Confirm Label -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/label_password_confirm"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:textColor="@color/text_primary"
                    android:layout_marginBottom="8dp" />

                <!-- Password Confirm Input -->
                <EditText
                    android:id="@+id/etSignupPasswordConfirm"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:hint="@string/hint_password_confirm"
                    android:textSize="14sp"
                    android:textColorHint="@color/text_secondary"
                    android:background="@drawable/input_background"
                    android:paddingHorizontal="20dp"
                    android:inputType="textPassword"
                    android:autofillHints="password"
                    android:layout_marginBottom="24dp" />

                <!-- Signup Button -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnSignup"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:text="@string/btn_signup"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:textColor="@color/text_white"
                    app:backgroundTint="#7C99FF"
                    app:cornerRadius="12dp"
                    android:elevation="0dp"
                    app:elevation="0dp" />

                <!-- Divider with Text -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginVertical="20dp">

                    <View
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_height="1dp"
                        android:background="@color/border_light" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/divider_or"
                        android:textSize="12sp"
                        android:textColor="@color/text_secondary"
                        android:paddingHorizontal="12dp" />

                    <View
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_height="1dp"
                        android:background="@color/border_light" />

                </LinearLayout>

                <!-- Kakao Signup Button -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnKakaoSignup"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:text="@string/btn_kakao_signup"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:textColor="@color/text_primary"
                    app:icon="@drawable/ic_kakao"
                    app:iconGravity="textStart"
                    app:iconPadding="8dp"
                    app:iconTint="@color/text_primary"
                    app:backgroundTint="@color/kakao_yellow"
                    app:cornerRadius="12dp"
                    android:elevation="0dp"
                    app:elevation="0dp" />

            </LinearLayout>

        </androidx.cardview.widget.CardView>

        <!-- Footer Notice -->
        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="@string/terms_notice"
            android:textSize="11sp"
            android:textColor="@color/text_secondary"
            android:gravity="center"
            android:lineSpacingExtra="2dp"
            android:layout_marginTop="20dp"
            app:layout_constraintTop_toBottomOf="@id/signupCard"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintBottom_toBottomOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>

</ScrollView>
